#!/usr/bin/env python3
"""kali の起動ラッパー。インストール先（../lib/kali-incus）またはリポジトリ（../src）を探す。"""

import os
import sys

here = os.path.dirname(os.path.realpath(__file__))
for cand in (os.path.join(here, "..", "lib", "kali-incus"), os.path.join(here, "..", "src")):
    if os.path.isdir(os.path.join(cand, "kali_incus")):
        sys.path.insert(0, os.path.normpath(cand))
        break

from kali_incus.cli import main  # noqa: E402

sys.exit(main())
